# Copy to backend/.env and fill in. backend/.env is git-ignored.

# --- Salesforce Connected App (Setup > App Manager > New Connected App) ---
# Callback URL in the Connected App must be: http://localhost:5173/connection/callback
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v61.0

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Security ---
# Encrypts Salesforce tokens at rest. Generate one with:
#   .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty in development, a key is created in backend/.data/token.key.
TOKEN_ENCRYPTION_KEY=

# --- Database (defaults to SQLite in backend/.data/aquarient.db) ---
# Use PostgreSQL for anything beyond one person's laptop. The schema is created and upgraded
# automatically on start-up (Alembic migrations in backend/migrations).
# DATABASE_URL=postgresql+psycopg://aquarient:CHANGE_ME@localhost:5432/aquarient

# --- Health check jobs ---
# embedded = checks run inside the API process (default, simplest)
# external = the API only queues checks; run workers with:  python -m app.worker
JOB_MODE=embedded
WORKER_THREADS=1
# WORKER_HEARTBEAT_TIMEOUT_SECONDS=120
# JOB_MAX_ATTEMPTS=2

# --- Default admin (optional): created at start-up while there are no users yet ---
# Set these as host secrets (e.g. Railway variables), never in committed files.
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_ADMIN_NAME=Admin

# --- Local profile shown until sign-in is enabled ---
LOCAL_USER_NAME=Local User
LOCAL_USER_EMAIL=user@localhost
