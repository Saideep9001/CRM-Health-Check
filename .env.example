# ---------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------
# Base path/URL of the Aquarient FastAPI backend (default /api/v1)
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server forwards /api requests (development only, ignored when # ---------------------------------------------------------------
# Sign-in (off by default). true = require /login before using the app.
# ---------------------------------------------------------------
VITE_AUTH_REQUIRED=false

DEV_API=true)
VITE_API_PROXY_TARGET=http://localhost:8000

# ---------------------------------------------------------------
# Local development API (dev server only — never used in production builds)
# Copy to .env.local and fill in. .env.local is git-ignored.
# ---------------------------------------------------------------
DEV_API=true
# Used only when VITE_AUTH_REQUIRED=true
DEV_LOGIN_EMAIL=you@yourcompany.com
DEV_LOGIN_PASSWORD=choose-a-local-password

# Optional: a Salesforce Connected App for the real OAuth flow.
# Callback URL in the Connected App must be http://localhost:5173/connection/callback
SF_CLIENT_ID=
SF_CLIENT_SECRET=

