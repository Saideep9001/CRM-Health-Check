# ---------------------------------------------------------------
# Website settings. Copy to .env.local (git-ignored) and restart the dev server after editing.
# Sign-in is controlled by the backend (AUTH_REQUIRED in backend/.env), not here.
# ---------------------------------------------------------------

# Base path/URL of the Aquarient FastAPI backend (default /api/v1)
VITE_API_BASE_URL=/api/v1

# false = the dev server forwards /api to the real backend below (normal use).
# true  = use the built-in mock API in dev-server/devApi.ts instead (no backend; demo data only).
DEV_API=false
VITE_API_PROXY_TARGET=http://localhost:8000

# Mock API only (DEV_API=true): sign-in for the mock, and optional Connected App keys.
VITE_AUTH_REQUIRED=false
DEV_LOGIN_EMAIL=you@yourcompany.com
DEV_LOGIN_PASSWORD=choose-a-local-password
# Callback URL in the Connected App must be http://localhost:5173/connection/callback
SF_CLIENT_ID=
SF_CLIENT_SECRET=
